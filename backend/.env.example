NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blogging?schema=public"
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=*
RESET_TOKEN_EXPIRES_MIN=60
RESET_PASSWORD_URL=http://localhost:5173/reset-password
# Optional SMTP (if empty, reset links are printed to the server console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Blogging <no-reply@blogging.local>"
COOKIE_NAME=access_token
